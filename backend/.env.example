# Server Configuration
PORT=3000
NODE_ENV=development

# Database Settings (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/sales_intel_db?schema=public&connection_limit=10"

# Caching and Queue Settings (Redis)
REDIS_URL="redis://localhost:6379"

# Security Settings
JWT_SECRET="super_secret_access_token_key_change_me_in_production"
JWT_REFRESH_SECRET="super_secret_refresh_token_key_change_me_in_production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# AI Provider Settings
OPENAI_API_KEY="your-openai-api-key-here"
